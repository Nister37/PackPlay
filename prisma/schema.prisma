generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  identity                        Identity?
  sessions                        Session[]
  emailVerificationTokens         EmailVerificationToken[]
  passwordResetTokens             PasswordResetToken[]
  groupMemberships                GroupMember[]
  createdInvitations              GroupInvitation[]
  sportProfiles                   SportProfile[]
  checklists                      Checklist[]
  createdActivities               GroupActivity[]                @relation("createdActivities")
  createdSharedItems              SharedItem[]                   @relation("createdSharedItems")
  sharedResponsibilities          SharedResponsibility[]
  packingSessions                 PackingSession[]
  notifications                   Notification[]
  outgoingResponsibilityTransfers ResponsibilityTransfer[]       @relation("transferFrom")
  incomingResponsibilityTransfers ResponsibilityTransfer[]       @relation("transferTo")
  recurrenceSeriesCreated         EventRecurrenceSeries[]        @relation("recurrenceSeriesCreated")
  eventMemberships                EventMember[]
  eventRoleAssignments            EventMemberRole[]
  eventLogEntries                 EventActivityLog[]
  preparationTemplates            PreparationTemplate[]          @relation("preparationTemplateCreated")
  templateVersions                PreparationTemplateVersion[]   @relation("templateVersionCreated")
  heldInventoryBatches            InventoryBatch[]               @relation("batchHolder")
  heldInventoryAssets             InventoryAsset[]               @relation("assetHolder")
  inventoryMovements              InventoryMovement[]            @relation("movementActor")
  inventoryDamageReports          InventoryDamageReport[]        @relation("damageReporter")
  inventoryCustodies              InventoryCustody[]             @relation("custodyHolder")
  equipmentSuggestionPreference   EquipmentSuggestionPreference?
  reviewedWeatherSuggestions      WeatherSuggestion[]            @relation("weatherSuggestionReviewer")
  createdCalendarFeeds            CalendarFeed[]                 @relation("calendarFeedCreated")
  externalIdentities              ExternalIdentity[]
  ssoAuthorizations               SsoAuthorization[]

  @@map("users")
}

enum SsoProvider {
  GOOGLE
}

enum SsoIntent {
  SIGN_IN
  LINK
}

model ExternalIdentity {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  provider  SsoProvider
  subject   String      @db.VarChar(255)
  email     String      @db.VarChar(320)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([email])
  @@map("external_identities")
}

model SsoAuthorization {
  id                    String      @id @default(uuid())
  stateHash             String      @unique @map("state_hash") @db.VarChar(64)
  provider              SsoProvider
  intent                SsoIntent
  userId                String?     @map("user_id")
  encryptedCodeVerifier String      @map("encrypted_code_verifier") @db.Text
  nonceHash             String      @map("nonce_hash") @db.VarChar(64)
  returnUrl             String?     @map("return_url") @db.VarChar(2048)
  expiresAt             DateTime    @map("expires_at")
  usedAt                DateTime?   @map("used_at")
  createdAt             DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sso_authorizations")
}

model Identity {
  id           String @id @default(uuid())
  userId       String @unique @map("user_id")
  passwordHash String @map("password_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identities")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum ActivityType {
  TRAINING
  COMPETITION
  CASUAL
  TRAVEL
}

model SportProfile {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String   @db.VarChar(100)
  activityTypes Json     @map("activity_types")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklists Checklist[]
  activities GroupActivity[]

  @@index([userId])
  @@map("sport_profiles")
}

model Checklist {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  sportProfileId String        @map("sport_profile_id")
  name           String        @db.VarChar(200)
  activityType   ActivityType? @map("activity_type")
  isTemplate     Boolean       @default(false) @map("is_template")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportProfile    SportProfile     @relation(fields: [sportProfileId], references: [id], onDelete: Cascade)
  items           EquipmentItem[]
  packingSessions PackingSession[]

  @@index([sportProfileId])
  @@index([userId])
  @@index([userId, createdAt])
  @@map("checklists")
}

model EquipmentItem {
  id              String   @id @default(uuid())
  checklistId     String   @map("checklist_id")
  name            String   @db.VarChar(200)
  quantity        Int      @default(1)
  category        String?  @db.VarChar(100)
  isMandatory     Boolean  @default(false) @map("is_mandatory")
  notes           String?  @db.Text
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  catalogueItemId String?  @map("catalogue_item_id")

  checklist        Checklist               @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  packingDecisions PackingDecision[]
  catalogueItem    EquipmentCatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([checklistId, sortOrder])
  @@index([catalogueItemId])
  @@map("equipment_items")
}

enum SharedResponsibilityStatus {
  COMMITTED
  PACKED
  RELEASED
  FORGOT
  COULD_NOT_BRING
  REPLACEMENT_ARRANGED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupActivityStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventEnvironment {
  INDOOR
  COVERED_OUTDOOR
  OUTDOOR
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum EventAttendanceStatus {
  UNKNOWN
  ATTENDING
  NOT_ATTENDING
  TENTATIVE
}

enum WeatherSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum WeatherSuggestionTarget {
  PERSONAL
  SHARED
}

enum CalendarProvider {
  GENERIC
  TEAMSNAP
  GAMECHANGER
}

enum InventoryTrackingType {
  BATCH
  ASSET
}

enum InventoryCondition {
  GOOD
  NEEDS_ATTENTION
  DAMAGED
  INCOMPLETE
  RETIRED
}

enum InventoryMovementType {
  RESERVATION
  RESERVATION_RELEASE
  CHECKOUT
  TRANSFER
  RETURN
  CORRECTION
  CONDITION_CHANGE
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  CANCELLED
}

model Group {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  sportType   String   @map("sport_type") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members                GroupMember[]
  invitations            GroupInvitation[]
  activities             GroupActivity[]
  notifications          Notification[]
  recurrenceSeries       EventRecurrenceSeries[]
  preparationTemplates   PreparationTemplate[]
  inventoryItems         InventoryItem[]
  storageLocations       InventoryStorageLocation[]
  inventoryMovements     InventoryMovement[]
  equipmentUsage         TeamEquipmentUsage[]
  weatherRulePreferences TeamWeatherRulePreference[]
  calendarFeeds          CalendarFeed[]

  @@map("groups")
}

model GroupMember {
  id       String          @id @default(uuid())
  userId   String          @map("user_id")
  groupId  String          @map("group_id")
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupInvitation {
  id          String    @id @default(uuid())
  groupId     String    @map("group_id")
  token       String    @db.VarChar(128)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  maxUses     Int?      @map("max_uses")
  useCount    Int       @default(0) @map("use_count")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([expiresAt])
  @@map("group_invitations")
}

model GroupActivity {
  id                     String              @id @default(uuid())
  groupId                String              @map("group_id")
  name                   String              @db.VarChar(200)
  description            String?             @db.Text
  sportProfileId         String?             @map("sport_profile_id")
  activityType           ActivityType        @map("activity_type")
  status                 GroupActivityStatus @default(DRAFT)
  date                   DateTime?
  endAt                  DateTime?           @map("end_at")
  venueName              String?             @map("venue_name") @db.VarChar(200)
  latitude               Decimal?            @db.Decimal(9, 6)
  longitude              Decimal?            @db.Decimal(9, 6)
  environment            EventEnvironment?
  surface                String?             @db.VarChar(100)
  responsibilityDeadline DateTime?           @map("responsibility_deadline")
  archivedAt             DateTime?           @map("archived_at")
  recurrenceSeriesId     String?             @map("recurrence_series_id")
  occurrenceIndex        Int?                @map("occurrence_index")
  createdById            String              @map("created_by_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  group              Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sportProfile       SportProfile?          @relation(fields: [sportProfileId], references: [id], onDelete: SetNull)
  createdBy          User                   @relation("createdActivities", fields: [createdById], references: [id], onDelete: Cascade)
  sharedItems        SharedItem[]
  packingSessions    PackingSession[]
  recurrenceSeries   EventRecurrenceSeries? @relation(fields: [recurrenceSeriesId], references: [id], onDelete: SetNull)
  roles              EventRole[]
  eventMembers       EventMember[]
  activityLog        EventActivityLog[]
  inventoryMovements InventoryMovement[]
  inventoryCustodies InventoryCustody[]
  weatherSnapshots   WeatherSnapshot[]
  weatherSuggestions WeatherSuggestion[]
  calendarImport     CalendarImportedEvent?

  @@unique([recurrenceSeriesId, occurrenceIndex])
  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([groupId, status, date])
  @@index([groupId, venueName])
  @@map("group_activities")
}

model EventRecurrenceSeries {
  id          String              @id @default(uuid())
  groupId     String              @map("group_id")
  frequency   RecurrenceFrequency
  interval    Int                 @default(1)
  daysOfWeek  Json?               @map("days_of_week")
  customRule  Json?               @map("custom_rule")
  timezone    String              @db.VarChar(100)
  until       DateTime?
  count       Int?
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("recurrenceSeriesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  activities GroupActivity[]

  @@index([groupId])
  @@map("event_recurrence_series")
}

model EventRole {
  id           String   @id @default(uuid())
  activityId   String   @map("activity_id")
  name         String   @db.VarChar(100)
  requirements Json?
  createdAt    DateTime @default(now()) @map("created_at")

  activity    GroupActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignments EventMemberRole[]

  @@unique([activityId, name])
  @@map("event_roles")
}

model EventMember {
  id               String                @id @default(uuid())
  activityId       String                @map("activity_id")
  userId           String                @map("user_id")
  attendanceStatus EventAttendanceStatus @default(UNKNOWN) @map("attendance_status")
  packingAt        DateTime?             @map("packing_at")
  leavingAt        DateTime?             @map("leaving_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  activity GroupActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId])
  @@map("event_members")
}

model EventMemberRole {
  id          String   @id @default(uuid())
  eventRoleId String   @map("event_role_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  eventRole EventRole @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventRoleId, userId])
  @@index([userId])
  @@map("event_member_roles")
}

model EventActivityLog {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(100)
  itemId     String?  @map("item_id")
  quantity   Int?
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  activity GroupActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actor    User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([activityId, createdAt])
  @@index([activityId, actorId])
  @@index([activityId, itemId])
  @@map("event_activity_log")
}

model PreparationTemplate {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  name        String   @db.VarChar(200)
  description String?  @db.Text
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group     Group                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User                         @relation("preparationTemplateCreated", fields: [createdById], references: [id], onDelete: Cascade)
  versions  PreparationTemplateVersion[]

  @@index([groupId, updatedAt])
  @@map("preparation_templates")
}

model PreparationTemplateVersion {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  version     Int
  snapshot    Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  template  PreparationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User                @relation("templateVersionCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@map("preparation_template_versions")
}

model CalendarFeed {
  id               String           @id @default(uuid())
  groupId          String           @map("group_id")
  provider         CalendarProvider @default(GENERIC)
  name             String           @db.VarChar(200)
  encryptedUrl     String           @map("encrypted_url") @db.Text
  urlHash          String           @unique @map("url_hash") @db.VarChar(64)
  active           Boolean          @default(true)
  lastSyncedAt     DateTime?        @map("last_synced_at")
  lastSuccessfulAt DateTime?        @map("last_successful_at")
  lastError        String?          @map("last_error") @db.VarChar(1000)
  createdById      String           @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  group          Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation("calendarFeedCreated", fields: [createdById], references: [id], onDelete: Cascade)
  importedEvents CalendarImportedEvent[]

  @@index([groupId, active])
  @@map("calendar_feeds")
}

model CalendarImportedEvent {
  id           String   @id @default(uuid())
  feedId       String   @map("feed_id")
  externalUid  String   @map("external_uid") @db.VarChar(255)
  recurrenceId String   @default("") @map("recurrence_id") @db.VarChar(100)
  activityId   String   @unique @map("activity_id")
  sequence     Int      @default(0)
  sourceHash   String   @map("source_hash") @db.VarChar(64)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")

  feed     CalendarFeed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  activity GroupActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([feedId, externalUid, recurrenceId])
  @@index([feedId, lastSeenAt])
  @@map("calendar_imported_events")
}

model WeatherSnapshot {
  id                  String   @id @default(uuid())
  activityId          String   @map("activity_id")
  forecastTime        DateTime @map("forecast_time")
  temperature         Float
  apparentTemperature Float    @map("apparent_temperature")
  precipitation       Float
  windSpeed           Float    @map("wind_speed")
  uvIndex             Float    @map("uv_index")
  source              String   @default("Open-Meteo") @db.VarChar(100)
  fetchedAt           DateTime @default(now()) @map("fetched_at")
  fingerprint         String   @db.VarChar(64)
  raw                 Json?

  activity    GroupActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  suggestions WeatherSuggestion[]

  @@unique([activityId, fingerprint])
  @@index([activityId, fetchedAt])
  @@map("weather_snapshots")
}

model WeatherSuggestion {
  id             String                  @id @default(uuid())
  activityId     String                  @map("activity_id")
  snapshotId     String                  @map("snapshot_id")
  ruleKey        String                  @map("rule_key") @db.VarChar(100)
  itemName       String                  @map("item_name") @db.VarChar(200)
  reason         String                  @db.VarChar(1000)
  quantity       Int                     @default(1)
  target         WeatherSuggestionTarget
  status         WeatherSuggestionStatus @default(PENDING)
  reviewedById   String?                 @map("reviewed_by_id")
  reviewedAt     DateTime?               @map("reviewed_at")
  acceptedItemId String?                 @map("accepted_item_id")
  createdAt      DateTime                @default(now()) @map("created_at")

  activity   GroupActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  snapshot   WeatherSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("weatherSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([activityId, ruleKey, snapshotId])
  @@index([activityId, status])
  @@map("weather_suggestions")
}

model TeamWeatherRulePreference {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  ruleKey   String   @map("rule_key") @db.VarChar(100)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, ruleKey])
  @@map("team_weather_rule_preferences")
}

model SharedItem {
  id               String   @id @default(uuid())
  groupActivityId  String   @map("group_activity_id")
  name             String   @db.VarChar(200)
  requiredQuantity Int      @default(1) @map("required_quantity")
  category         String?  @db.VarChar(100)
  isMandatory      Boolean  @default(true) @map("is_mandatory")
  notes            String?  @db.Text
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  catalogueItemId  String?  @map("catalogue_item_id")

  groupActivity           GroupActivity            @relation(fields: [groupActivityId], references: [id], onDelete: Cascade)
  createdBy               User                     @relation("createdSharedItems", fields: [createdById], references: [id], onDelete: Cascade)
  responsibilities        SharedResponsibility[]
  packingDecisions        PackingDecision[]
  responsibilityTransfers ResponsibilityTransfer[]
  inventoryReservations   InventoryReservation[]
  catalogueItem           EquipmentCatalogueItem?  @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  @@index([groupActivityId])
  @@index([catalogueItemId])
  @@map("shared_items")
}

model InventoryItem {
  id           String                @id @default(uuid())
  groupId      String                @map("group_id")
  name         String                @db.VarChar(200)
  description  String?               @db.Text
  category     String?               @db.VarChar(100)
  unit         String                @default("piece") @db.VarChar(50)
  trackingType InventoryTrackingType @map("tracking_type")
  archivedAt   DateTime?             @map("archived_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  group   Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  batches InventoryBatch[]
  assets  InventoryAsset[]

  @@index([groupId, archivedAt])
  @@index([groupId, name])
  @@map("inventory_items")
}

model InventoryStorageLocation {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  name      String   @db.VarChar(200)
  details   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group   Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  batches InventoryBatch[]
  assets  InventoryAsset[]

  @@unique([groupId, name])
  @@map("inventory_storage_locations")
}

model InventoryBatch {
  id                String             @id @default(uuid())
  inventoryItemId   String             @map("inventory_item_id")
  quantity          Int
  availableQuantity Int                @map("available_quantity")
  condition         InventoryCondition @default(GOOD)
  locationId        String?            @map("location_id")
  holderId          String?            @map("holder_id")
  qrTokenHash       String?            @unique @map("qr_token_hash")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  inventoryItem InventoryItem             @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location      InventoryStorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  holder        User?                     @relation("batchHolder", fields: [holderId], references: [id], onDelete: SetNull)
  reservations  InventoryReservation[]
  movements     InventoryMovement[]
  damageReports InventoryDamageReport[]
  custodies     InventoryCustody[]

  @@index([inventoryItemId])
  @@index([locationId])
  @@index([holderId])
  @@map("inventory_batches")
}

model InventoryAsset {
  id              String             @id @default(uuid())
  inventoryItemId String             @map("inventory_item_id")
  assetTag        String             @map("asset_tag") @db.VarChar(100)
  serialNumber    String?            @map("serial_number") @db.VarChar(200)
  condition       InventoryCondition @default(GOOD)
  locationId      String?            @map("location_id")
  holderId        String?            @map("holder_id")
  qrTokenHash     String?            @unique @map("qr_token_hash")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  inventoryItem InventoryItem             @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location      InventoryStorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  holder        User?                     @relation("assetHolder", fields: [holderId], references: [id], onDelete: SetNull)
  reservations  InventoryReservation[]
  movements     InventoryMovement[]
  damageReports InventoryDamageReport[]
  custodies     InventoryCustody[]

  @@unique([inventoryItemId, assetTag])
  @@index([locationId])
  @@index([holderId])
  @@map("inventory_assets")
}

model InventoryReservation {
  id           String                     @id @default(uuid())
  sharedItemId String                     @map("shared_item_id")
  batchId      String?                    @map("batch_id")
  assetId      String?                    @map("asset_id")
  quantity     Int                        @default(1)
  status       InventoryReservationStatus @default(ACTIVE)
  createdAt    DateTime                   @default(now()) @map("created_at")
  releasedAt   DateTime?                  @map("released_at")

  sharedItem SharedItem      @relation(fields: [sharedItemId], references: [id], onDelete: Cascade)
  batch      InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset      InventoryAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([sharedItemId, status])
  @@index([batchId, status])
  @@index([assetId, status])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id             String                @id @default(uuid())
  groupId        String                @map("group_id")
  batchId        String?               @map("batch_id")
  assetId        String?               @map("asset_id")
  type           InventoryMovementType
  quantity       Int                   @default(1)
  fromLocationId String?               @map("from_location_id")
  toLocationId   String?               @map("to_location_id")
  fromHolderId   String?               @map("from_holder_id")
  toHolderId     String?               @map("to_holder_id")
  activityId     String?               @map("activity_id")
  actorId        String                @map("actor_id")
  details        Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  batch    InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  asset    InventoryAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  activity GroupActivity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)
  actor    User            @relation("movementActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([batchId, createdAt])
  @@index([assetId, createdAt])
  @@index([activityId, createdAt])
  @@map("inventory_movements")
}

model InventoryDamageReport {
  id         String             @id @default(uuid())
  batchId    String?            @map("batch_id")
  assetId    String?            @map("asset_id")
  condition  InventoryCondition
  note       String?            @db.Text
  photoUrl   String?            @map("photo_url") @db.VarChar(2048)
  reporterId String             @map("reporter_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  batch    InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset    InventoryAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reporter User            @relation("damageReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@index([assetId, createdAt])
  @@map("inventory_damage_reports")
}

model InventoryCustody {
  id           String    @id @default(uuid())
  batchId      String?   @map("batch_id")
  assetId      String?   @map("asset_id")
  holderId     String    @map("holder_id")
  activityId   String?   @map("activity_id")
  quantity     Int       @default(1)
  purpose      String?   @db.VarChar(500)
  checkedOutAt DateTime  @default(now()) @map("checked_out_at")
  dueAt        DateTime? @map("due_at")
  returnedAt   DateTime? @map("returned_at")

  batch    InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset    InventoryAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holder   User            @relation("custodyHolder", fields: [holderId], references: [id], onDelete: Restrict)
  activity GroupActivity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([batchId, returnedAt])
  @@index([assetId, returnedAt])
  @@index([holderId, returnedAt])
  @@index([activityId])
  @@map("inventory_custodies")
}

model EquipmentCatalogueItem {
  id            String   @id @default(uuid())
  canonicalName String   @unique @map("canonical_name") @db.VarChar(200)
  category      String   @db.VarChar(100)
  sports        Json
  roles         Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  aliases        EquipmentCatalogueAlias[]
  checklistItems EquipmentItem[]
  sharedItems    SharedItem[]
  teamUsage      TeamEquipmentUsage[]

  @@index([category, active])
  @@map("equipment_catalogue_items")
}

model EquipmentCatalogueAlias {
  id              String @id @default(uuid())
  catalogueItemId String @map("catalogue_item_id")
  alias           String @db.VarChar(200)

  catalogueItem EquipmentCatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)

  @@unique([catalogueItemId, alias])
  @@index([alias])
  @@map("equipment_catalogue_aliases")
}

model TeamEquipmentUsage {
  id              String   @id @default(uuid())
  groupId         String   @map("group_id")
  catalogueItemId String   @map("catalogue_item_id")
  useCount        Int      @default(0) @map("use_count")
  lastUsedAt      DateTime @default(now()) @map("last_used_at")

  group         Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  catalogueItem EquipmentCatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)

  @@unique([groupId, catalogueItemId])
  @@index([groupId, lastUsedAt])
  @@map("team_equipment_usage")
}

model EquipmentSuggestionPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  personalizedRanking Boolean  @default(true) @map("personalized_ranking")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("equipment_suggestion_preferences")
}

enum ResponsibilityTransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model ResponsibilityTransfer {
  id           String                       @id @default(uuid())
  sharedItemId String                       @map("shared_item_id")
  fromUserId   String                       @map("from_user_id")
  toUserId     String                       @map("to_user_id")
  quantity     Int
  status       ResponsibilityTransferStatus @default(PENDING)
  createdAt    DateTime                     @default(now()) @map("created_at")
  respondedAt  DateTime?                    @map("responded_at")

  sharedItem SharedItem @relation(fields: [sharedItemId], references: [id], onDelete: Cascade)
  fromUser   User       @relation("transferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User       @relation("transferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([sharedItemId, status])
  @@map("responsibility_transfers")
}

model SharedResponsibility {
  id                String                     @id @default(uuid())
  sharedItemId      String                     @map("shared_item_id")
  userId            String                     @map("user_id")
  committedQuantity Int                        @default(1) @map("committed_quantity")
  packedQuantity    Int                        @default(0) @map("packed_quantity")
  extraQuantity     Int                        @default(0) @map("extra_quantity")
  status            SharedResponsibilityStatus @default(COMMITTED)
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  sharedItem SharedItem @relation(fields: [sharedItemId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedItemId, userId])
  @@index([userId, status])
  @@map("shared_responsibilities")
}

// ─── Packing Epic ───────────────────────────────────────────────────────────

enum PackingSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PackingDecisionType {
  PACKED
  NOT_PACKED
  SKIPPED
}

enum PackingDecisionReason {
  FORGOT
  COULD_NOT_BRING
  REPLACEMENT_ARRANGED
  NOT_NEEDED
}

enum NotificationType {
  ITEM_MISSING
  ITEM_RELEASED
  ITEM_CLAIMED
  ITEM_PACKED
  TAKEOVER_REQUESTED
  COVERAGE_UPDATED
  READINESS_UPDATED
}

model PackingSession {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  groupActivityId String?              @map("group_activity_id")
  checklistId     String               @map("checklist_id")
  status          PackingSessionStatus @default(IN_PROGRESS)
  startedAt       DateTime             @default(now()) @map("started_at")
  completedAt     DateTime?            @map("completed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupActivity GroupActivity?    @relation(fields: [groupActivityId], references: [id], onDelete: SetNull)
  checklist     Checklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  decisions     PackingDecision[]

  @@index([userId, status])
  @@index([groupActivityId, userId, createdAt])
  @@map("packing_sessions")
}

model PackingDecision {
  id               String                 @id @default(uuid())
  packingSessionId String                 @map("packing_session_id")
  equipmentItemId  String?                @map("equipment_item_id")
  sharedItemId     String?                @map("shared_item_id")
  decision         PackingDecisionType
  reason           PackingDecisionReason?
  notes            String?                @db.Text
  decidedAt        DateTime               @default(now()) @map("decided_at")

  packingSession PackingSession @relation(fields: [packingSessionId], references: [id], onDelete: Cascade)
  equipmentItem  EquipmentItem? @relation(fields: [equipmentItemId], references: [id], onDelete: SetNull)
  sharedItem     SharedItem?    @relation(fields: [sharedItemId], references: [id], onDelete: SetNull)

  @@index([packingSessionId])
  @@index([packingSessionId, equipmentItemId])
  @@index([packingSessionId, sharedItemId])
  @@map("packing_decisions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  groupId   String?          @map("group_id")
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
