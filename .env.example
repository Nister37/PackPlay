# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Email verification (set to 'false' to disable — useful when SMTP is not configured)
REQUIRE_EMAIL_VERIFICATION=true

# Database (MySQL 8)
DATABASE_URL=mysql://packplay:packplay_secret@localhost:3306/packplay
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=packplay
MYSQL_USER=packplay
MYSQL_PASSWORD=packplay_secret
MYSQL_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# JWT (fill when implementing auth)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d


# SMTP (optional — if not set, emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@packplay.app
